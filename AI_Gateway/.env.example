# =============================================================================
# AI Gateway — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All variables are prefixed with GATEWAY_ to avoid conflicts.

# --- Server ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_DEBUG=true
GATEWAY_LOG_LEVEL=INFO

# --- Database ---
# Dev mode: SQLite (no setup needed)
GATEWAY_DATABASE_URL=sqlite+aiosqlite:///./gateway.db
# Prod mode: PostgreSQL (uncomment below)
# GATEWAY_DATABASE_URL=postgresql+asyncpg://gateway_user:gateway_pass@localhost:5432/ai_gateway

# --- Redis ---
# Dev mode: leave empty to use in-memory cache/rate limiting
GATEWAY_REDIS_URL=
# Prod mode: uncomment below
# GATEWAY_REDIS_URL=redis://localhost:6379/0

# --- Google Gemini ---
# google-genai uses the API key only (no base URL).
GATEWAY_GEMINI_API_KEY=your-gemini-api-key-here

# --- OpenAI / Anthropic (optional; can also be added from the admin UI) ---
GATEWAY_OPENAI_API_KEY=
GATEWAY_OPENAI_BASE_URL=https://api.openai.com/v1
GATEWAY_ANTHROPIC_API_KEY=

# --- Ollama (Local) ---
GATEWAY_OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- OpenTelemetry ---
# Dev mode: leave empty to use console exporter (prints to stdout)
GATEWAY_OTEL_ENDPOINT=
# Prod mode: uncomment below
# GATEWAY_OTEL_ENDPOINT=http://localhost:4317

# --- Config File Paths ---
GATEWAY_MODELS_CONFIG_PATH=config/models.yaml
GATEWAY_ROUTES_CONFIG_PATH=config/routes.yaml

# --- Admin ---
# Master admin key for /admin/* endpoints (auto-generated if empty)
GATEWAY_ADMIN_KEY=

# --- Secret used to encrypt provider API keys at rest ---
GATEWAY_SECRET_KEY=change-me-in-production

# --- Alert webhooks (comma-separated) ---
GATEWAY_ALERT_WEBHOOKS=
